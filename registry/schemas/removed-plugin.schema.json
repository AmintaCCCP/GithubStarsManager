{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AmintaCCCP/GithubStarsManager/registry/schemas/removed-plugin.schema.json",
  "title": "Removed community plugins",
  "description": "Plugin versions that must no longer be installed. revoke stops installed versions immediately; block prevents new installations.",
  "type": "array",
  "$comment": "CI rejects overlapping records for the same plugin, including all-version and version-specific overlaps.",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "versions", "reason", "date", "action"],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      },
      "versions": {
        "type": "array",
        "description": "Empty array means every version of this plugin.",
        "items": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "uniqueItems": true
      },
      "reason": { "type": "string", "minLength": 10 },
      "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
      "action": { "type": "string", "enum": ["revoke", "block"] }
    }
  }
}
