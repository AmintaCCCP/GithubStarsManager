{
  "name": "github-stars-manager",
  "private": true,
  "version": "0.8.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run sync-version",
    "build": "vite build && npm run check:bundle-size",
    "check:bundle-size": "node scripts/check-bundle-size.cjs",
    "bundle:report": "node scripts/bundle-report.cjs",
    "check:boundaries": "node scripts/check-boundaries.cjs",
    "check:i18n": "node scripts/check-i18n.cjs",
    "check:plugin-registry": "node scripts/check-plugin-registry.cjs",
    "check:pr-release-files": "node scripts/check-pr-release-files.cjs",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run && npm run test:electron:mcp && npm run test:electron:diagnostics && npm run test:electron:plugins && npm run test:update-version && npm run test:ci-gates && npm run test:deploy-vector",
    "test:electron:mcp": "node --test electron/mcpLocalServer.test.js electron/repoHealth.test.js electron/desktopPrefs.test.js electron/xAuthStorage.test.js electron/mainFetch.test.js electron/outboundFetchGate.test.js",
    "test:electron:diagnostics": "node --test electron/diagLogger.test.js electron/redact.test.js electron/netTap.test.js electron/systemInfo.test.js",
    "test:electron:plugins": "node --test electron/plugins/*.test.js",
    "test:update-version": "node --test scripts/update-version.test.cjs",
    "test:deploy-vector": "node --test scripts/deploy-vector.test.mjs",
    "test:ci-gates": "node --test scripts/check-pr-release-files.test.cjs scripts/check-i18n.test.cjs scripts/check-plugin-registry.test.cjs scripts/fullstack-compose-env.test.cjs",
    "test:coverage": "vitest run --coverage",
    "build:desktop": "node scripts/build-desktop.js",
    "electron": "electron electron/main.js",
    "electron:dev": "NODE_ENV=development electron electron/main.js",
    "predist": "npm run sync-version",
    "dist": "electron-builder",
    "sync-version": "node scripts/update-version.cjs --sync-lock",
    "update-version": "node scripts/update-version.cjs",
    "gen:themes": "node scripts/generate-theme-presets.mjs",
    "dev:server": "cd server && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build:server": "cd server && npm run build",
    "build:all": "npm run build && npm run build:server",
    "deploy:vector": "node cloudflare-worker/deploy.mjs"
  },
  "dependencies": {
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@eslint/js": "^9.9.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "ai": "^7.0.143",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.0",
    "date-fns": "^3.3.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "github-markdown-css": "^5.9.0",
    "globals": "^15.9.0",
    "highlight.js": "^11.11.1",
    "i18next": "^26.5.2",
    "jsdom": "^30.1.3",
    "katex": "^0.19.0",
    "lucide-react": "^1.59.0",
    "mermaid": "^12.2.0",
    "postcss": "^8.5.30",
    "query-string": "^9.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "ts-morph": "^28.0.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "xml2js": "^0.6.2",
    "zod": "^4.6.7",
    "zustand": "^4.5.0"
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "katex": "$katex",
    "postcss-selector-parser": "^7.1.6"
  }
}
